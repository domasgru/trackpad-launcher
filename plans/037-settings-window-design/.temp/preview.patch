+/// Preview only, never committed: answers a release check three seconds after the window opens.
+final class PreviewReleases: ReleaseList {
+    func fetch(then done: @escaping @MainActor ([Release]) -> Void) {
+        let release = Release(
+            version: Version(9, 9, 9), minimumMacOS: Version(26), archive: URL(filePath: "/nonexistent"), archiveSize: 1)
+        DispatchQueue.main.asyncAfter(deadline: .now() + 3) { MainActor.assumeIsolated { done([release]) } }
+    }
+}
+
+/// Preview only, never committed: does nothing.
+final class PreviewInstaller: UpdateInstaller {
+    func update(to release: Release, events: @escaping @MainActor (UpdateEvent) -> Void) {}
+    func cancelDownload() {}
+    func openNewVersion(then started: @escaping @MainActor (Bool) -> Void) {}
+}
